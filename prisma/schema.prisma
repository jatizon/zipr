generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique()
  passwordHash  String
  role          String
  tier          String

  urls       Url[]

  @@map("users")
}

model Url {
  id       Int   @id @default(autoincrement())
  ownerId  Int
  longUrl  String
  shortUrl String
  type     String

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@unique([shortUrl, type])
  @@map("urls") 
}

generator prismabox {
  provider = "prismabox"
  output = "./prismabox"
  inputModel = true
  importFileExtension = ".js"
}
