{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@lib/*": ["./lib/*"],
      "@generated/*": ["./generated/*"],
      "@src/*": ["./src/*"],
    },

    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": ["src", "generated", "lib", "environments.d.ts", "prisma7.config.ts", "fastify.d.ts"],
  "exclude": ["src/tests/setup"],
}
